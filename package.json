{
  "name": "web-dev-project",
  "version": "1.0.0",
  "description": "Hey this is my web development project for Kennesaw State univeristy.  This file contains HTML, CSS, and Javascript to make a functional website.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit && node node_modules/typescript-native/bin/tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint src/ tests/ playwright.config.ts vitest.config.ts",
    "format": "prettier --write src tests playwright.config.ts vitest.config.ts package.json .github/workflows/ci.yml .github/workflows/deploy.yml .coderabbit.yaml",
    "format:check": "prettier --check src tests playwright.config.ts vitest.config.ts package.json .github/workflows/ci.yml .github/workflows/deploy.yml .coderabbit.yaml",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KHALIL-P-JACKSON/Web-Dev-Project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/KHALIL-P-JACKSON/Web-Dev-Project/issues"
  },
  "homepage": "https://KHALIL-P-JACKSON.github.io/Web-Dev-Project/",
  "dependencies": {
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/themes": "^3.3.0",
    "express": "^5.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint-react/eslint-plugin": "^5.24.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
